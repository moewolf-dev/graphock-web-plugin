{
  "name": "graphock-web-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @graphock/extension build",
    "dev": "pnpm --filter @graphock/extension dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "protocol:receive": "tsx packages/protocol-receiver/src/cli.ts",
    "package:chrome": "node tooling/package/zip-chrome.mjs",
    "test:e2e": "pnpm qa",
    "build:e2e": "E2E_HOST_PERMISSION=1 pnpm build",
    "build:safari": "SAFARI=1 pnpm --filter @graphock/extension build",
    "safari:project": "node tooling/build/safari-project.mjs",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "lint:licenses": "node tooling/ci/audit-licenses.mjs",
    "lint:dco": "node tooling/ci/check-dco.mjs HEAD~1..HEAD",
    "package:safari": "node tooling/package/archive-safari.mjs",
    "qa": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test",
    "qa:ui": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --ui",
    "qa:update": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --update-snapshots",
    "qa:nightly": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --grep @nightly"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@types/chrome": "^0.0.287",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.14.1",
    "defuddle": "^0.19.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
