{
  "name": "graphock-web-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @graphock/extension build",
    "dev": "pnpm --filter @graphock/extension dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "protocol:receive": "tsx packages/protocol-receiver/src/cli.ts",
    "package:chrome": "node tooling/package/zip-chrome.mjs",
    "test:e2e": "E2E_HOST_PERMISSION=1 pnpm build && E2E_HOST_PERMISSION=1 node tests/e2e/smoke.mjs",
    "build:e2e": "E2E_HOST_PERMISSION=1 pnpm build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
