{
  "name": "graphock-web-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @graphock/extension build",
    "dev": "pnpm --filter @graphock/extension dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "protocol:receive": "tsx packages/protocol-receiver/src/cli.ts",
    "package:chrome": "node tooling/package/zip-chrome.mjs",
    "build:chrome:store": "GRAPHOCK_APP_HANDOFF=0 pnpm build",
    "package:chrome:store": "pnpm build:chrome:store && node tooling/package/zip-chrome.mjs --local-only",
    "build:e2e:local": "E2E_HOST_PERMISSION=1 GRAPHOCK_APP_HANDOFF=0 pnpm build",
    "qa:chrome:local": "node tooling/qa/verify-local-release.mjs",
    "qa:store-assets": "node tooling/qa/store-assets.mjs",
    "release:version:next": "node tooling/release/version.mjs",
    "release:publish:cws": "node tooling/release/cws-publish.mjs",
    "test:e2e": "pnpm qa",
    "build:e2e": "E2E_HOST_PERMISSION=1 pnpm build",
    "build:safari": "SAFARI=1 pnpm --filter @graphock/extension build",
    "safari:project": "node tooling/build/safari-project.mjs",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "lint:licenses": "node tooling/ci/audit-licenses.mjs",
    "lint:dco": "node tooling/ci/check-dco.mjs HEAD~1..HEAD",
    "package:safari": "node tooling/package/archive-safari.mjs",
    "qa": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test",
    "qa:samples": "node tooling/qa/make-system-e2e-samples.mjs",
    "qa:system": "node tooling/qa/system-verify.mjs",
    "qa:ui": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --ui",
    "qa:update": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --update-snapshots",
    "qa:nightly": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --grep @nightly",
    "qa:linux": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --grep-invert @visual",
    "qa:visual": "pnpm build && E2E_HOST_PERMISSION=1 pnpm build && playwright test --grep @visual",
    "release:safari:local": "node tooling/package/local-safari-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "defuddle": "^0.19.13",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
